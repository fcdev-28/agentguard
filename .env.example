# Cadena de conexión a PostgreSQL (fase 10). Copia este fichero a `.env` y
# pega tu connection string real. `.env` está en .gitignore (no se commitea).
#
# Opciones para obtener una:
#   - Postgres local sin Docker:   npx prisma dev
#   - Prisma Postgres (cloud free): npx create-db
#   - Neon / Supabase (free tier):  copia el connection string de su panel
DATABASE_URL="postgresql://usuario:password@host:5432/agentguard?schema=public"

# Secreto para firmar la cookie de sesión (JWT HS256, fase 11). Obligatorio:
# la app lanza al arrancar si falta o mide menos de 32 caracteres. Genera uno
# distinto por entorno, p. ej. con `openssl rand -base64 48`.
AUTH_SECRET=genera-uno-con-openssl-rand-base64-48

# Secreto del barrido de auto-escalado por SLA (fase 12, POST
# /api/cron/escalate). Lo invoca un scheduler externo (Vercel Cron, GitHub
# Actions o curl) con `Authorization: Bearer $CRON_SECRET`. Debe ser un
# secreto largo y aleatorio (misma entropía que AUTH_SECRET, p. ej.
# `openssl rand -base64 48`); sin la longitud adecuada, la comparación en
# tiempo constante no protege nada.
CRON_SECRET=

# Envío de email real vía Resend (fase 12). Sin estas dos variables, el
# runner de ejecución cae al transporte de logging (registra por consola,
# no envía nada).
RESEND_API_KEY=
EMAIL_FROM=
