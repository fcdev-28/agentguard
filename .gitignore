# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files: se ignoran todos salvo la plantilla
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
# Grafo de conocimiento de graphify: cada quien genera el suyo en local
# (ver CLAUDE.md). Se ignora el directorio entero, no solo cost.json.
graphify-out/
# Capturas de referencia de diseño: productos de terceros, solo en local
docs/design/refs/
# Config local de Claude Code (hooks con rutas de la máquina, permisos)
.claude/settings.json
.claude/settings.local.json
